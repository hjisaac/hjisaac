---
import { GITHUB_ICON_PATH, isSafeHttpUrl, mdInlineToHtml } from '../lib/format';

interface Props {
    title: string;
    codeUrl?: string | null;
    demoUrl?: string | null;
    meta: string;
    details?: string[] | null;
    summary?: string | null;
    tools: string[];
    footnote?: string | null;
    footnoteMarker?: number | null;
    viewLiveLabel: string;
}

const { title, codeUrl, demoUrl, meta, details, summary, tools, footnote, footnoteMarker, viewLiveLabel } = Astro.props;

const hasGithubLink = isSafeHttpUrl(codeUrl);
const hasDemoLink = isSafeHttpUrl(demoUrl);
---

<article class="entry">
    <header class="entry-header">
        <div class="entry-title-row">
            {codeUrl && (
                hasGithubLink ? (
                    <a class="project-github-link" href={codeUrl} target="_blank" rel="noopener noreferrer" aria-label={`${title} on GitHub`}>
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={GITHUB_ICON_PATH} /></svg>
                    </a>
                ) : (
                    <span class="project-github-link" aria-disabled="true" aria-label={`${title} on GitHub`}>
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={GITHUB_ICON_PATH} /></svg>
                    </span>
                )
            )}
            <h3 class="entry-title">
                {title}
                {footnoteMarker != null && <sup class="footnote-ref">{footnoteMarker}</sup>}
            </h3>
        </div>
        <p class="entry-meta">
            {meta}
            {hasDemoLink && (
                <Fragment>
                    {' · '}
                    <a class="entry-meta-link" href={demoUrl} target="_blank" rel="noopener noreferrer">{viewLiveLabel}</a>
                </Fragment>
            )}
        </p>
    </header>

    {details && details.length > 0 ? (
        <ul class="entry-list">
            {details.map((item) => (
                <li set:html={mdInlineToHtml(item)} />
            ))}
        </ul>
    ) : summary && (
        <p class="entry-summary" set:html={mdInlineToHtml(summary)} />
    )}

    {tools.length > 0 && (
        <p class="entry-tools">
            {tools.map((tool) => <span class="tool-tag">{tool}</span>)}
        </p>
    )}

    {footnote && (
        <p class="entry-footnote">
            {footnoteMarker != null && <sup>{footnoteMarker}</sup>} {footnote}
        </p>
    )}
</article>
