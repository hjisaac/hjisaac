---
import { GITHUB_ICON_PATH, EXTERNAL_LINK_ICON_PATH } from '../lib/icons';
import { isSafeHttpUrl, mdInlineToHtml } from '../lib/format';

interface Props {
    title: string;
    code_url?: string | null;
    demo_url?: string | null;
    meta: string;
    details?: string[] | null;
    summary?: string | null;
    tools: string[];
    footnote?: string | null;
    footnoteMarker?: number | null;
    viewLiveLabel: string;
}

const { title, code_url, demo_url, meta, details, summary, tools, footnote, footnoteMarker, viewLiveLabel } = Astro.props;

const hasGithubLink = isSafeHttpUrl(code_url);
const hasDemoLink = isSafeHttpUrl(demo_url);
---

<article class="entry">
    <header class="entry-header">
        <div class="entry-title-row">
            {code_url && (
                hasGithubLink ? (
                    <a class="project-icon-link" href={code_url} target="_blank" rel="noopener noreferrer" title="GitHub" aria-label={`${title} on GitHub`}>
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={GITHUB_ICON_PATH} /></svg>
                    </a>
                ) : (
                    <span class="project-icon-link" aria-disabled="true" aria-label={`${title} on GitHub`}>
                        <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={GITHUB_ICON_PATH} /></svg>
                    </span>
                )
            )}
            <h3 class="entry-title">
                {title}
                {footnoteMarker != null && <sup class="footnote-ref">{footnoteMarker}</sup>}
            </h3>
            {hasDemoLink && (
                <a class="project-icon-link" href={demo_url} target="_blank" rel="noopener noreferrer" title={viewLiveLabel} aria-label={`${title} — ${viewLiveLabel}`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d={EXTERNAL_LINK_ICON_PATH} />
                    </svg>
                </a>
            )}
        </div>
        <p class="entry-meta">{meta}</p>
    </header>

    {details && details.length > 0 ? (
        <ul class="entry-list">
            {details.map((item) => (
                <li set:html={mdInlineToHtml(item)} />
            ))}
        </ul>
    ) : summary && (
        <p class="entry-summary" set:html={mdInlineToHtml(summary)} />
    )}

    {tools.length > 0 && (
        <p class="entry-tools">
            {tools.map((tool, index) => (
                <Fragment>
                    {index > 0 && ', '}
                    <span class="tool-tag">{tool}</span>
                </Fragment>
            ))}
        </p>
    )}

    {footnote && (
        <p class="entry-footnote">
            {footnoteMarker != null && <sup>{footnoteMarker}</sup>} {footnote}
        </p>
    )}
</article>
