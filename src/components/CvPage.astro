---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Section from './Section.astro';
import EntryCard from './EntryCard.astro';
import ProjectCard from './ProjectCard.astro';
import SkillsGroup from './SkillsGroup.astro';
import ContactForm from './ContactForm.astro';
import ArticleCard from './ArticleCard.astro';
import Footer from './Footer.astro';
import { loadCv, getSection } from '../lib/cv';
import { parseMarkdownLink } from '../lib/format';
import { ARTICLES_ENABLED } from '../lib/articles';
import {
    toExperienceCardProps,
    toEducationCardProps,
    toProjectCardProps,
    toPaperCardProps,
    toSkillsGroups,
} from '../lib/adapters';
import type { WorkExperienceItem, EducationItem, ProjectItem, PaperItem } from '../lib/types.generated';
import type { Locale } from '../i18n/locales';
import { siteLocale as en } from '../i18n/site_locale/en';
import { siteLocale as fr } from '../i18n/site_locale/fr';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const t = { en, fr }[locale];

const cv = loadCv(locale);

const experienceEntries = getSection<WorkExperienceItem>(cv, 'work_experience').map(toExperienceCardProps);
const educationEntries = getSection<EducationItem>(cv, 'education').map(toEducationCardProps);
const projectEntries = getSection<ProjectItem>(cv, 'projects').map(toProjectCardProps);
const paperEntries = getSection<PaperItem>(cv, 'papers').map(toPaperCardProps);
const skillsGroups = toSkillsGroups(cv.skills, t.sections.skills.labels);

// Footnote markers are auto-incremented in page document order (education, then projects) —
// cvitae no longer carries per-entry marker numbers, see planning decision.
let footnoteCounter = 0;
const educationCards = educationEntries.map((entry) => ({
    ...entry,
    footnoteMarker: entry.footnote ? ++footnoteCounter : null,
}));
const projectCards = projectEntries.map((entry) => ({
    ...entry,
    footnoteMarker: entry.footnote ? ++footnoteCounter : null,
}));

const emailContact = cv.contact.find((c) => c.name === 'email');
const linkedinContact = cv.contact.find((c) => c.name === 'linkedin');
const githubContact = cv.contact.find((c) => c.name === 'github');

const emailLink = emailContact ? parseMarkdownLink(emailContact.value) : null;
const sameAs = [linkedinContact, githubContact]
    .map((c) => (c ? parseMarkdownLink(c.value) : null))
    .filter((link): link is { label: string; url: string } => link !== null)
    .map((link) => link.url);

const { sections } = t;

// Dummy content (experiments/jobs/) is English-only for now — only show the
// Articles section on the English page until real, translated articles exist.
const showArticles = ARTICLES_ENABLED && locale === 'en';
const articles = showArticles
    ? (await getCollection('articles', ({ data }) => data.published)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    : [];

// Every section but Contact is hidden outright when it has no content, so a
// CV variant/locale missing e.g. papers doesn't show an empty heading.
const hasExperience = experienceEntries.length > 0;
const hasEducation = educationCards.length > 0;
const hasSkills = skillsGroups.length > 0;
const hasProjects = projectCards.length > 0;
const hasPapers = paperEntries.length > 0;
const hasArticles = showArticles && articles.length > 0;

const hiddenSectionIds = new Set(
    [
        !hasExperience && sections.experience.id,
        !hasEducation && sections.education.id,
        !hasSkills && sections.skills.id,
        !hasProjects && sections.projects.id,
        !hasPapers && sections.papers.id,
    ].filter((id): id is string => Boolean(id)),
);

const navItems = [
    ...t.nav.filter((item) => !hiddenSectionIds.has(item.href.slice(1))),
    ...(hasArticles ? [{ href: `#${sections.articles.id}`, label: sections.articles.title }] : []),
];
---

<Layout
    locale={locale}
    title={t.meta.title}
    description={t.meta.description}
    ogImage={t.intro.headshot}
    person={{
        name: cv.name,
        jobTitle: cv.title,
        image: t.intro.headshot,
        email: emailLink ? emailLink.url.replace(/^mailto:/, '') : undefined,
        sameAs,
    }}
>
    <Header logo={t.header.logo} nav={navItems} menu_open={t.ui.menu_open} menu_close={t.ui.menu_close} />

    <main>
        <div class="intro-block">
            <Hero
                greeting={t.intro.greeting}
                role_highlight={t.intro.role_highlight}
                headshot={t.intro.headshot}
                headshot_alt={t.intro.headshot_alt}
            />
            <p class="summary high-line-height">{cv.summary}</p>
        </div>

        <div>
            {hasExperience && (
                <Section id={sections.experience.id} title={sections.experience.title} theme={sections.experience.theme}>
                    {experienceEntries.map((entry) => <EntryCard {...entry} />)}
                </Section>
            )}

            {hasEducation && (
                <Section id={sections.education.id} title={sections.education.title} theme={sections.education.theme}>
                    {educationCards.map((entry) => <EntryCard {...entry} />)}
                </Section>
            )}

            {hasSkills && (
                <Section id={sections.skills.id} title={sections.skills.title} theme={sections.skills.theme}>
                    {skillsGroups.map((group) => <SkillsGroup {...group} />)}
                </Section>
            )}

            {hasProjects && (
                <Section id={sections.projects.id} title={sections.projects.title} theme={sections.projects.theme}>
                    {projectCards.map((entry) => (
                        <ProjectCard {...entry} viewLiveLabel={t.ui.project_view_label} />
                    ))}
                </Section>
            )}

            <Section id={sections.contact.id} title={sections.contact.title} theme={sections.contact.theme}>
                <ContactForm
                    prompt={sections.contact.prompt}
                    cv_file={sections.contact.cv_file}
                    download_intro={sections.contact.download_intro}
                    download_label={sections.contact.download_label}
                    form={sections.contact.form}
                    ui={t.ui}
                />
            </Section>

            {hasPapers && (
                <Section id={sections.papers.id} title={sections.papers.title} theme={sections.papers.theme}>
                    {paperEntries.map((entry) => <EntryCard {...entry} />)}
                </Section>
            )}

            {hasArticles && (
                <Section id={sections.articles.id} title={sections.articles.title} theme={sections.articles.theme}>
                    {articles.map((article) => (
                        <ArticleCard slug={article.id} title={article.data.title} date={article.data.date} description={article.data.description} />
                    ))}
                </Section>
            )}
        </div>

        <Footer
            locale={locale}
            copyright={t.footer.copyright}
            note_before_link={t.footer.note_before_link}
            contact_link_label={t.footer.contact_link_label}
            contact_href={t.footer.contact_href}
        />
    </main>
</Layout>
